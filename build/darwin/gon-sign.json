{
  "source": ["./build/bin/BingPaperDesktop.app"],
  "bundle_id": "APPLE_BUNDLE_ID",
  "sign": {
    "application_identity": "APPLE_IDENTITY"
  },
  "notarize": [{
    "path": "./build/bin/BingPaperDesktop_macos.zip",
    "bundle_id": "APPLE_BUNDLE_ID",
    "staple": false
  }, {
    "path": "./build/bin/BingPaperDesktop_macos.dmg",
    "bundle_id": "APPLE_BUNDLE_ID",
    "staple": true
  }],
  "apple_id": {
    "username": "APPLE_ID_USER",
    "password": "APPLE_PASSWORD",
    "provider": "APPLE_PROVIDER"
  },
  "zip": {
    "output_path": "./build/bin/BingPaperDesktop_macos.zip"
  },
  "dmg": {
    "output_path": "./build/bin/BingPaperDesktop_macos.dmg",
    "volume_name": "BingPaperDesktop"
  }
}
